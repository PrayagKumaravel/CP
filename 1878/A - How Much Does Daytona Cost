import java.util.*;
public class AHowMuchDoesDaytonaCost{
    public static void main(String[] args){
        Scanner pr=new Scanner(System.in);
        int t=pr.nextInt();
        while(t-- > 0){
            int n=pr.nextInt();
            int k=pr.nextInt();
            int[] arr=new int[n];
            for(int i=0;i<arr.length;i++){
                arr[i]=pr.nextInt();
            }
            int count=0;
            for(int x:arr){
                if(x==k){
                    count++;
                }
            }
            System.out.println(count!=0?"YES":"NO");
        }
        pr.close();
    }
}